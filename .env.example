# Application Settings
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# WhatsApp / Webhook Settings
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_KEY=
WHAPI_TOKEN=

# Drone Connection Settings (Set tcp:127.0.0.1:5760 for SITL or /dev/ttyUSB0 for physical hardware)
DRONE_CONNECTION_STRING=tcp:127.0.0.1:5760
DRONE_BAUDRATE=115200
DRONE_CONNECTION_TIMEOUT=15
DRONE_ARM_TIMEOUT=30

# Flight & Safety Boundaries
HOME_LAT=9.9816
HOME_LON=76.2999
MAX_GEOFENCE_METERS=20000.0
TAKEOFF_ALTITUDE_METERS=15.0

# Logging Settings
LOG_LEVEL=INFO
LOG_DIR=logs
